# Copy to .env or export these before running the server. All of them are optional.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=180
USE_OLLAMA=1
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-before-you-deploy
